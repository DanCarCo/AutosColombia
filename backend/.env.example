# Ejemplos: completa backend/.env con tus datos locales. No publiques ese archivo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CAMBIAR_BASE_DE_DATOS
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_PASSWORD
DB_CONNECT_TIMEOUT=5

# Clave para firmar los tokens de inicio de sesión de operadores (RF-16).
# Genera un valor propio y secreto, por ejemplo con:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRATION_MINUTES=480
